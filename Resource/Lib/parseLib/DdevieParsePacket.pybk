        pktindex = 0
        with  open(home + sep + file, 'rb') as fi:
            hello1 = dpkt.pcap.Reader(fi)
            sni_dict = {}
            value_pkt = []
            for timestamp, pkt in hello1:
                sni_dict_1 = {}
                pktindex += 1
                start = 0
                end = len(pkt)
                # print(pkt)
                for index in range(len(pkt)-9):
                    value = pkt[start:start + 9]
                    ext_type,ext_len,sni_list,sni_type,sni_len = struct.unpack("!3HBH",value)
                    # print(ext_type,ext_len,sni_len)
                    if ext_type == 0 and ext_len-sni_len == 5 and sni_len !=0:
                        # sni_servername = "".join(list(struct.unpack(">%sc"%sni_len,sni_len,pkt[(start+9),(start+9+sni_len)])))
                        sni_start = start+9
                        sni_end = start+9+sni_len
                        sni_servername = "".join([i.decode() for i in struct.unpack(">%sc"%sni_len,pkt[sni_start:sni_end])])
                        # print(struct.unpack(">%sc"%sni_len,pkt[sni_start:sni_end]))
                        sni_dict_1[start] = [sni_servername,len(sni_servername),len(pkt)]
                        #{offset:[sni_name,sni_len,pkt_len]}
                        start+= 1
                        if len(sni_servername) >= sni_len_filter:
                            value_pkt.append(pkt)
                    else:
                        start += 1
                sni_dict[pktindex]=sni_dict_1
                # {pktindex:{offset:[sni_name,sni_len,pkt_len]}}
            if value_pkt:
                wrpcap("{}{}new_{}".format(home, sep, file), value_pkt)
            return sni_dict

    def snichange(self,path="C:\\Users\\peiwe\\Desktop\\test",newvalue=1,step=1,newvaluetype="str",mode="change",sep="win",offset=None):
        home, file = os.path.split(path)
        sep = '\\' if 'win' in str(sep).lower() else '/'
        value = []
        # change_list = [1, 2, 3,5,7,11,13,14,15,16,18,20,22,23,25,27,28,29,30,31] #==ali_dns 483
        # change_list = [1,2,3]
        change_list = [1]
        pktindex = 0
        with  open(home + sep + file, 'rb') as fi:
            hello1 = dpkt.pcap.Reader(fi)
            sni_dict = {}
            for timestamp, pkt in hello1:
                sni_dict_1 = {}
                pktindex += 1
                start = 0
                end = len(pkt)
                dest_data = b''
                hello = str(binascii.hexlify(raw(pkt)), encoding='utf-8')
                # print(pkt)
                if pktindex in change_list:
                    for index in range(len(pkt)-9):
                        value1 = pkt[start:start + 9]
                        ext_type,ext_len,sni_list,sni_type,sni_len = struct.unpack("!3HBH",value1)
                        # print(ext_type,ext_len,sni_len)
                        if ext_type == 0 and ext_len-sni_len == 5 and sni_len:
                            # sni_servername = "".join(list(struct.unpack(">%sc"%sni_len,sni_len,pkt[(start+9),(start+9+sni_len)])))
                            sni_start = start+9
                            sni_end = start+9+sni_len
                            sni_servername = "".join([i.decode() for i in struct.unpack(">%sc"%sni_len,pkt[sni_start:sni_end])])
                            # print(struct.unpack(">%sc"%sni_len,pkt[sni_start:sni_end]))
                            sni_dict_1[start] = [sni_servername,len(sni_servername),len(pkt)]
                            #{offset:[sni_name,sni_len,pkt_len]}
                            break
                        else:
                            start += 1
                    if not sni_dict_1:continue
                    sni_dict[pktindex]=sni_dict_1
                    # {pktindex:{offset:[sni_name,sni_len,pkt_len]}}
                    offset = start if not offset else offset
                    # print(offset)
                    if pktindex in change_list:
                        newvalue_qq = "{:>0{}}".format(hex(newvalue)[2:], step * 2) if newvaluetype != "str" else "".join(
                            self.mult_bytes_to_one_byte(step, self.str_process(newvalue)))
                        if mode == "change":
                            # newhello = hello[0:offset*2]+"{:>0{}}".format(hex(newvalue)[2:],step*2)+hello[(offset+step)*2:]
                            newhello = hello[0:offset * 2] + newvalue_qq + hello[(offset + step) * 2:]
                        elif mode == "add":
                            newhello = hello[0:offset * 2] + newvalue_qq + hello[(offset) * 2:]
                        elif mode == "inc":
                            newhello = hello[0:offset * 2] + hello[(offset + step) * 2:]
                        newhelloList = [newhello[x:x + 2] for x in range(0, len(newhello), 2)]
                        for dest in newhelloList:  # 主要是对字符串转为符合网络传送的bytes格式
                            dest_t = int(str(dest), 16)
                            dest_data += struct.pack('B', dest_t)
                        value.append(dest_data)
                else:
                    value.append(pkt)
            if value:
                wrpcap("{}{}new_{}".format(home, sep, file), value)
            else:
                wrpcap("{}{}new_{}".format(home, sep, file), value)

    def generate_random_urls(self,count):
        for _ in range(count):
            random_uuid = uuid.uuid4()
            hex_str = random_uuid.hex[-12:]
            yield "{0}".format(hex_str)
    def str_bytes(self,str_con_list):
        dest_data = b''
        for dest in str_con_list:  # 主要是对字符串转为符合网络传送的bytes格式
            dest_t = int(str(dest), 16)
            dest_data += struct.pack('B', dest_t)
        return dest_data

    def make_1000(self,path="C:\\Users\\peiwe\\Desktop\\test",sep="win",step=10,offset=1802,count=100):
        home, file = os.path.split(path)
        sep = '\\' if 'win' in str(sep).lower() else '/'
        with  open(home + sep + file, 'rb') as fi:
            hello1 = dpkt.pcap.Reader(fi)
            for timestamp, pkt in hello1:
                hello = str(binascii.hexlify(raw(pkt)), encoding='utf-8')
                break
            newvalue_iter = self.generate_random_urls(count)
            value = []
            for newvalue in newvalue_iter:
                dest_data = b''
                newvalue_qq =  "".join( self.mult_bytes_to_one_byte(step, self.str_process(newvalue)))
                newhello = hello[0:offset * 2] + newvalue_qq + hello[(offset + step) * 2:]
                # newhello_en = newhello.encode()
                newhelloList = [newhello[x:x + 2] for x in range(0, len(newhello), 2)]
                dest_data = self.str_bytes(newhelloList)
                value.append(dest_data)
            wrpcap("{}{}new_{}".format(home, sep, file), value)


    def bj_net_flow_1(self, configName):
        simpleType = {}
        pkt_index = 0


        for i in self.pkts:
            common = confignetflow.netflow(configName).getNetflow("common")
            netflowv4 = confignetflow.netflow(configName).getNetflow("netflow_v4")
            netflowv6 = confignetflow.netflow(configName).getNetflow("netflow_v6")
            netflowv4Size = int(netflowv4.pop("size"))
            netflowv6Size = int(netflowv6.pop("size"))

            pkt_index += 1
            flow_info = str(binascii.hexlify(bytes(i)),encoding="utf-8")
            # print(len(flow_info))
            comvalue = {}
            startwith = 0
            v4_flw = 0
            v6_flw = 0
            for key in common:
                type = None if len(common[key].split(',')) == 2 else common[key].split(',')[2]
                #print(type)
                comvalue[key] =self.formatChange(flow_info[int(common[key].split(',')[0])*2:(int(common[key].split(',')[0])+int(common[key].split(',')[1]))*2],type)
            for flw_cnt in range(int(comvalue["fl_cnt"])):
                comvalue['first_zx_ip_ver'] = self.formatChange(flow_info[(int(netflowv4["zx_ip_ver"].split(',')[0])+startwith) * 2:(int(
                            netflowv4["zx_ip_ver"].split(',')[0]) + int(netflowv4["zx_ip_ver"].split(',')[1])+startwith) * 2], "dec")
                if comvalue['first_zx_ip_ver'] == 4:
                    for netflow in netflowv4:
                        typeva = None if len(netflowv4[netflow].split(',')) == 2 else netflowv4[netflow].split(',')[2]
                        print(typeva)
                        comvalue["{}{}".format(netflow,flw_cnt)] = self.formatChange(flow_info[(int(netflowv4[netflow].split(',')[0])+startwith) * 2:(int(
                            netflowv4[netflow].split(',')[0]) + int(netflowv4[netflow].split(',')[1])+startwith) * 2], typeva)
                        print(netflow)
                        print(comvalue)
                    startwith += netflowv4Size
                    v4_flw += 1
                elif comvalue['first_zx_ip_ver'] == 6:
                    for netflow in netflowv6:
                        typeva = None if len(netflowv6[netflow].split(',')) == 2 else netflowv6[netflow].split(',')[
                            2]
                        comvalue["{}{}".format(netflow,flw_cnt)] = self.formatChange(flow_info[(int(netflowv6[netflow].split(',')[0])+startwith) * 2:(int(netflowv6[netflow].split(',')[0]) + int(netflowv6[netflow].split(',')[1])+startwith) * 2], typeva)
                    startwith += netflowv6Size
                    v6_flw += 1
                comvalue["v4_flow_count"]=  v4_flw
                comvalue["v6_flow_count"] = v6_flw
                comvalue["cal_len"] = int(v4_flw)*netflowv4Size + int(v6_flw)*netflowv6Size + 46 +4
                simpleType[pkt_index] = comvalue
            # if pkt_index == 1 :break
        return simpleType


