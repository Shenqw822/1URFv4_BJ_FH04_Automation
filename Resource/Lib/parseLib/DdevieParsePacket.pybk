    def add_crc(self,path="C:\\Users\\peiwe\\Desktop\\test", sep="win"):
        sep = '\\' if 'win' in str(sep).lower() else '/'
        for home, folder, files in os.walk(path):
            for file in files:
                if "123.pcap" not in file: continue
                pkindex = 0
                index = []
                value = []
                with  open(home + sep + file, 'rb') as fi:
                    hello1 = dpkt.pcap.Reader(fi)
                    for timestamp, pkt in hello1:
                        dest_data = b''
                        pkindex += 1
                        cc = str(binascii.hexlify(pkt), encoding="utf-8")[0:-8]
                        ddd = bytes(bytes(str(binascii.hexlify(pkt), encoding="utf-8"), encoding="utf-8"))[0:-8]
                        crc = hex(binascii.crc32(binascii.a2b_hex(ddd)) & 0xffffffff)
                        crc_quan = "{:0>8}".format(crc[2:])
                        crc_quan_two = [crc_quan[i:i + 2] for i in range(0, len(crc_quan), 2)]
                        crc_fin = "".join(list(reversed(crc_quan_two)))
                        # print(ddd + bytes(crc_fin,encoding="utf-8"))
                        add_crc_packet = cc + crc_fin
                        newhelloList = [add_crc_packet[x:x + 2] for x in range(0, len(add_crc_packet), 2)]
                        print(newhelloList)
                        for dest in newhelloList:  # 主要是对字符串转为符合网络传送的bytes格式
                            dest_t = int(str(dest), 16)
                            dest_data += struct.pack('B', dest_t)
                        value.append(dest_data)
                if value:
                    wrpcap("{}{}new_{}".format(home, sep, file), value)
                else:
                    wrpcap("{}{}new_{}".format(home, sep, file), value)

    def get_string_weizhi(self,path,value,sep='win'):
        """

        :param path:
        :param value: 为16进制的数据
        :param sep:
        :return:
        """
        home,file = os.path.split(path)
        sep = '\\' if 'win' in str(sep).lower() else '/'
        index_value = []
        index_dns={}   #唯一的dns信息
        index_dns_org = {}  #所有的dns信息
        index = 0
        bytes_count={} #需要统计的包
        dns_count=0

        with  open(home + sep + file, 'rb') as fi:
            hello1 = dpkt.pcap.Reader(fi)
            for timestamp, pkt in hello1:
                index += 1
                dest_data = b''
                hello = str(binascii.hexlify(raw(pkt)),encoding='utf-8')
                # print(hello)
                weizhi = hello.find(value)
                # print(weizhi)
                if  weizhi != -1 and weizhi<443:
                    index_value.append(index)
                    index_dns_org[index] = bytes.fromhex(hello[weizhi - 22:weizhi + 6]).decode("utf-8")
                    if bytes.fromhex(hello[weizhi - 22:weizhi + 6]).decode("utf-8") in index_dns.values():
                        bytes_count[index] = len(hello)//2 +4
                    else:
                        bytes_count[index] = len(hello) // 2 + 4
                        index_dns[index] = bytes.fromhex(hello[weizhi - 22:weizhi + 6]).decode("utf-8")
                        dns_count += 1
                if dns_count == 10:break
        return index_dns_org,index_dns,bytes_count

    def str_process(self, data):
        """
        针对字符串内容进行处理，主要是登录用到的用户名,把其转为ASCII
        :param data:
        :return:对应字符的ASCII列表
        """
        a = []
        for i in data:
            # 转为对应的ascii码
            # ascii_value = ord(str(i))
            # 临时处理0不进行转换
            # ascii_value = ord(str(i)) if str(i) != '0' else int(i)
            ascii_value = ord(str(i)) if str(i) != '0' else '48' #为应对ascii 0 对应的ascii的值为48
            ascii_value = ord(str(i)) if str(i) != '0' else '48'  # 为应对ascii 0 对应的ascii的值为48
            a.append(str(ascii_value))
            # a.append(hex(int(str(ascii_value))))
        # print(a) #调试专用
        return  a

    def mult_bytes_to_one_byte(self, bytecounts, data, is_hex=False):
        """
        针对存在某个值对应的字节数字为多个的时候，需要针对数据实际占有字节数和帧格式中的字节个数不匹配需要考虑用0代替
        :param bytecounts: 帧格式中分配的字节数
        :param data: 实际的数据
        :return: 帧格式中每个字段的值 [a,b,c]
        """
        if is_hex:
            if int(bytecounts) == 1:
                data1 = data if len(data) == 2 else "0" + str(data)
                return data1
            else:
                if isinstance(data, list):
                    tmp = []
                    for i in data:
                        data1 = data if len(data) == 2 else "0" + str(data)
                        tmp.append(data1)
                    data_hex = ''.join(tmp)
                else:
                    # data1 = data if len(data) == bytecounts*2 else "0" + str(data)
                    data_hex = data
                # print(data_hex)
                # 先对实际数据进行处理，使得和其占用字节数进行对其 不足用0填充
                if len(data_hex) < int(bytecounts) * 2:
                    cha = int(bytecounts) * 2 - len(data_hex)
                    # new_data_hex = data_hex + '0' * cha
                    new_data_hex = '0' * cha + data_hex
                else:
                    new_data_hex = data_hex
        else:
            if int(bytecounts) == 1:
                return self.dec_to_hex(data[0])
            # 先转为16进制
            if isinstance(data, list):
                tmp = []
                for i in data:
                    tmp.append(self.dec_to_hex(i))
                data_hex = ''.join(tmp)
            else:
                data_hex = self.dec_to_hex(data)
            # print(data_hex)
            # 先对实际数据进行处理，使得和其占用字节数进行对其 不足用0填充
            if len(data_hex) < int(bytecounts) * 2:
                cha = int(bytecounts) * 2 - len(data_hex)
                # new_data_hex = data_hex + '0' * cha
                new_data_hex = '0' * cha + data_hex
            else:
                new_data_hex = data_hex
            # print(new_data_hex)  # 调试用
            # print(re.findall(r'\w{2}', new_data_hex)) # 调试用
            # 对新的数据进行按长度2进行分割，返回列表
        return re.findall(r'\w{2}', new_data_hex)

    def dec_to_hex(self, data):
        """
        10进制转为16进制，且去掉0x内容,且保证输出的都是两位
        :param data: 普通内容
        :return:
        """

        num = int(data)
        mid = []
        while True:
            if num == 0:
                break
            num, rem = divmod(num, 16)
            mid.append(base[rem])
        a = ''.join([str(x) for x in mid[::-1]])
        if len(a) == 1 and a:
            b = '0' + str(a)
        elif not a:
            b = '00'
        else:
            b = a
        return b

